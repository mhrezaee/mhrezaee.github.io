---
import '../styles/global.css';
import { profile, socials } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.role}`,
  description = `${profile.name}, ${profile.role} at ${profile.company} in ${profile.location}. 15+ years in software development and architecture: .NET, Azure, Angular and AI-assisted engineering.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: profile.company },
  address: { '@type': 'PostalAddress', addressLocality: 'Vienna', addressCountry: 'AT' },
  url: profile.url,
  image: ogImage.href,
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#08080a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@DevRezaee" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Apply theme before paint to avoid a flash -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        const dark = t ? t === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches;
        d.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="relative min-h-dvh overflow-x-clip">
    <div aria-hidden="true" class="page-decor page-glow pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px]"></div>
    <div aria-hidden="true" class="scroll-progress fixed inset-x-0 top-0 z-[60] h-0.5 bg-accent"></div>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">
      Skip to content
    </a>

    <slot />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
