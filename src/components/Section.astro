---
interface Props {
  id: string;
  title: string;
  meta?: string;
}
const { id, title, meta } = Astro.props;
---

<section id={id} class="scroll-mt-20 py-10 first:pt-6 sm:py-14 lg:first:pt-16 print:py-3">
  <div data-reveal class="keep-with-next mb-7 flex items-baseline justify-between gap-4 border-b border-line pb-4 print:mb-3 print:pb-2">
    <h2 class="text-xs font-semibold tracking-[0.18em] text-fg uppercase">{title}</h2>
    {meta && <p class="font-mono text-xs text-subtle">{meta}</p>}
  </div>
  <slot />
</section>
