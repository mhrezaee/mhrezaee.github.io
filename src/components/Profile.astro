---
import Section from './Section.astro';
import { profile, keyFacts, competencies } from '../data/profile';
---

<Section id="profile" title="Profile">
  <div class="space-y-4 text-[17px] leading-[1.75] text-pretty text-muted print:text-[13px] print:leading-relaxed">
    {profile.summary.map((p, i) => <p data-reveal style={`--delay:${i * 60}ms`}>{p}</p>)}
  </div>

  <dl data-reveal class="mt-8 grid grid-cols-3 divide-x divide-line overflow-hidden rounded-xl border border-line bg-surface print:mt-4">
    {
      keyFacts.map((f) => (
        <div class="px-4 py-5 sm:px-6">
          <dd class="text-2xl font-semibold tracking-tight sm:text-3xl print:text-xl">{f.value}</dd>
          <dt class="mt-1 text-xs leading-snug text-subtle sm:text-sm">{f.label}</dt>
        </div>
      ))
    }
  </dl>

  <div data-reveal class="mt-8 print:mt-4">
    <p class="text-sm font-medium">Core competencies</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        competencies.map((c) => (
          <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm text-muted print:px-2 print:py-0.5 print:text-xs">{c}</li>
        ))
      }
    </ul>
  </div>
</Section>
